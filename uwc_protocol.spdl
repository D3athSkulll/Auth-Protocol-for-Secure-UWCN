/*
 * UWC authentication protocol of Rupa et al. (IEEE IoT-J 2025), Sec. IV - Scyther model.
 *
 * Messages M1-M12 carry exactly the paper's fields, in the paper's order. Each hop is its own two-role protocol:
 * the paper establishes one session per hop with hop-local nonces and timestamps, and Scyther's Alive / agreement
 * claims in a single five-role protocol would refer to all five roles, which no hop-local exchange can establish
 * (that variant also needs more than 9 minutes at 5 runs). All protocols run concurrently in one analysis.
 *
 * Abstractions: PEECC is ideal public-key encryption {..}pk(X), so Scyther CANNOT see the K-public flaw of
 * paper-exact PEECC (shown instead by `peecc --test` (test_K_is_public) and `simulate.py --attacks`). 8-bit
 * timestamps are fresh values, so their 12.8 s wrap-around is not modelled. Data forwarded upward (ENV, Alerts,
 * GPS) is modelled as fresh at each hop. Nothing was added to the messages to make claims hold.
 *
 * Run:  scyther-w32 --max-runs=5 uwc_protocol.spdl
 */

hashfunction H;
usertype Timestamp, Data;

/* ---- IoT Sec. IV-B: registration of entity I with entity J ------------------------------------------------
 * RID_I = H(ID_I || PU_I || PK_I), v_I = H(RID_I || PU_I); {RID_I, PU_I, v_I} is sent in the clear and J checks
 * v_I = H(RID_I || PU_I). */
protocol uwcreg(I, J)
{
    role I
    {
        send_R1(I, J, H(I, pk(I), sk(I)), pk(I), H(H(I, pk(I), sk(I)), pk(I)));
        claim(I, Secret, sk(I));
    }
    role J
    {
        var RID: Ticket;
        recv_R1(I, J, RID, pk(I), H(RID, pk(I)));
        claim(J, Alive);
    }
}

/* ---- IoT Sec. IV-C Steps 1-4: UWS <-> SUB, messages M1, M2, M3 -------------------------------------------- */
protocol hop1(UWS, SUB)
{
    role UWS
    {
        fresh Nuws: Nonce;
        fresh TS1, TS3: Timestamp;
        fresh Env: Data;
        var TS2: Timestamp;

        send_1(UWS, SUB, {UWS, Nuws, TS1}pk(SUB));
        recv_2(SUB, UWS, {SUB, Nuws, TS2}pk(UWS));
        send_3(UWS, SUB, {SUB, Env, TS3}pk(SUB));

        claim(UWS, Secret, Nuws);
        claim(UWS, Secret, Env);
        claim(UWS, Alive);
        claim(UWS, Weakagree);
        claim(UWS, Niagree);
        claim(UWS, Nisynch);
    }

    role SUB
    {
        var Nuws: Nonce;
        var TS1, TS3: Timestamp;
        var Env: Data;
        fresh TS2: Timestamp;

        recv_1(UWS, SUB, {UWS, Nuws, TS1}pk(SUB));
        send_2(SUB, UWS, {SUB, Nuws, TS2}pk(UWS));
        recv_3(UWS, SUB, {SUB, Env, TS3}pk(SUB));

        claim(SUB, Secret, Env);
        claim(SUB, Alive);
        claim(SUB, Weakagree);
        claim(SUB, Niagree);
        claim(SUB, Nisynch);
    }
}

/* ---- IoT Sec. IV-C Steps 5-8: SUB <-> B, messages M4, M5, M6 -------------------------------------------- */
protocol hop2(SUB, B)
{
    role SUB
    {
        fresh Nsub: Nonce;
        fresh TS4, TS6: Timestamp;
        fresh Env, Alerts: Data;
        var TS5: Timestamp;

        send_4(SUB, B, {SUB, Nsub, TS4}pk(B));
        recv_5(B, SUB, {B, Nsub, TS5}pk(SUB));
        send_6(SUB, B, {B, Env, Alerts, TS6}pk(B));

        claim(SUB, Secret, Nsub);
        claim(SUB, Secret, Env);
        claim(SUB, Secret, Alerts);
        claim(SUB, Alive);
        claim(SUB, Weakagree);
        claim(SUB, Niagree);
        claim(SUB, Nisynch);
    }

    role B
    {
        var Nsub: Nonce;
        var TS4, TS6: Timestamp;
        var Env, Alerts: Data;
        fresh TS5: Timestamp;

        recv_4(SUB, B, {SUB, Nsub, TS4}pk(B));
        send_5(B, SUB, {B, Nsub, TS5}pk(SUB));
        recv_6(SUB, B, {B, Env, Alerts, TS6}pk(B));

        claim(B, Secret, Env);
        claim(B, Secret, Alerts);
        claim(B, Alive);
        claim(B, Weakagree);
        claim(B, Niagree);
        claim(B, Nisynch);
    }
}

/* ---- IoT Sec. IV-C Steps 9-12: B <-> SAT, messages M7, M8, M9 -------------------------------------------- */
protocol hop3(B, SAT)
{
    role B
    {
        fresh Nb: Nonce;
        fresh TS7, TS9: Timestamp;
        fresh Env, Alerts, Gps: Data;
        var TS8: Timestamp;

        send_7(B, SAT, {B, Nb, TS7}pk(SAT));
        recv_8(SAT, B, {SAT, Nb, TS8}pk(B));
        send_9(B, SAT, {SAT, Env, Alerts, Gps, TS9}pk(SAT));

        claim(B, Secret, Nb);
        claim(B, Secret, Env);
        claim(B, Secret, Alerts);
        claim(B, Secret, Gps);
        claim(B, Alive);
        claim(B, Weakagree);
        claim(B, Niagree);
        claim(B, Nisynch);
    }

    role SAT
    {
        var Nb: Nonce;
        var TS7, TS9: Timestamp;
        var Env, Alerts, Gps: Data;
        fresh TS8: Timestamp;

        recv_7(B, SAT, {B, Nb, TS7}pk(SAT));
        send_8(SAT, B, {SAT, Nb, TS8}pk(B));
        recv_9(B, SAT, {SAT, Env, Alerts, Gps, TS9}pk(SAT));

        claim(SAT, Secret, Env);
        claim(SAT, Secret, Alerts);
        claim(SAT, Secret, Gps);
        claim(SAT, Alive);
        claim(SAT, Weakagree);
        claim(SAT, Niagree);
        claim(SAT, Nisynch);
    }
}

/* ---- IoT Sec. IV-C Steps 13-16: SAT <-> BS, messages M10, M11, M12 -------------------------------------------- */
protocol hop4(SAT, BS)
{
    role SAT
    {
        fresh Nsat: Nonce;
        fresh TS10, TS12: Timestamp;
        fresh Env, Alerts, Gps, Logs: Data;
        var TS11: Timestamp;

        send_10(SAT, BS, {SAT, Nsat, TS10}pk(BS));
        recv_11(BS, SAT, {BS, Nsat, TS11}pk(SAT));
        send_12(SAT, BS, {BS, Env, Alerts, Gps, Logs, TS12}pk(BS));

        claim(SAT, Secret, Nsat);
        claim(SAT, Secret, Env);
        claim(SAT, Secret, Alerts);
        claim(SAT, Secret, Gps);
        claim(SAT, Secret, Logs);
        claim(SAT, Alive);
        claim(SAT, Weakagree);
        claim(SAT, Niagree);
        claim(SAT, Nisynch);
    }

    role BS
    {
        var Nsat: Nonce;
        var TS10, TS12: Timestamp;
        var Env, Alerts, Gps, Logs: Data;
        fresh TS11: Timestamp;

        recv_10(SAT, BS, {SAT, Nsat, TS10}pk(BS));
        send_11(BS, SAT, {BS, Nsat, TS11}pk(SAT));
        recv_12(SAT, BS, {BS, Env, Alerts, Gps, Logs, TS12}pk(BS));

        claim(BS, Secret, Env);
        claim(BS, Secret, Alerts);
        claim(BS, Secret, Gps);
        claim(BS, Secret, Logs);
        claim(BS, Alive);
        claim(BS, Weakagree);
        claim(BS, Niagree);
        claim(BS, Nisynch);
    }
}
